# Copy to .env and fill in. .env is gitignored (mode 600).
# PC_BRIDGE_PORT=3420
# PC_BRIDGE_HOST=127.0.0.1
# PC_BRIDGE_KEY=   # normally use .pc-key instead
# CUA_DRIVER_CMD=cua-driver
# CUA_DRIVER_ARGS=mcp

# Optional — NOT required for local cua-driver MCP / this Muse tunnel path:
# CUA_API_KEY=
# CUA_RELAY_URL=https://relay.cua.ai
# CUA_RELAY_TOKEN=
